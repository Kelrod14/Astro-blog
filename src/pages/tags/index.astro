---
import BaseLayouts from "../../layouts/BaseLayouts.astro";

const title = "Indice de paginas"
const allPosts = await Astro.glob('../posts/*.md')
const tags = [... new Set(allPosts.map((post) => post.frontmatter.tags).flat())];
---
<BaseLayouts pageTitle={title}>
    <div>
        {tags.map((tag) => <a href={`/tags/${tag}`}><p>{tag}</p></a>)}
    </div>
</BaseLayouts>

<style>
  a {
    color: #00539F;
    text-decoration: none;
  }
  a :hover{
    color: #3791e5;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>