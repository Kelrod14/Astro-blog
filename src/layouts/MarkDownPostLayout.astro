---
import BaseLayouts from "./BaseLayouts.astro";

const { frontmatter } = Astro.props;
---
<BaseLayouts pageTitle={frontmatter.title}>
    <p>Escrito por {frontmatter.author}</p>
    <p>Publicado en: {frontmatter.pubDate.toString().slice(0,10)}</p>
    <p><em>Descripcion: {frontmatter.description}</em></p>
    <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />

    <div class="tags">
        {frontmatter.tags.map((tag) => <a href={`/tags/${tag}`}><p>{tag}</p></a>)}
    </div>

    <slot />  
</BaseLayouts>

<style>
  a {
    color: #00539F;
    text-decoration: none;
  }
  a :hover{
    color: #3791e5;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>
